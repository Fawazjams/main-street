# Copy to .env.local and fill in. Restart the dev server after changing this.

# Mapbox public token (starts with pk.) — https://account.mapbox.com/access-tokens/
# Without it the map panel shows a placeholder and the sidebar still works.
# This one is inlined into the JavaScript bundle, because the map, the walking
# routes and the static pin image all run in the browser. Anyone can lift it off
# a deployed site, so once you have a domain, restrict it to that domain in the
# Mapbox dashboard — and set MAPBOX_SERVER_TOKEN below before you do.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Mapbox token for server-side geocoding. Optional: without it the public token
# above is used instead, which is fine until that token is URL-restricted.
# Server requests carry no Referer, so a restricted token rejects them, and
# listings quietly stop getting pins. Give this one the geocoding scope only and
# no URL restriction. No NEXT_PUBLIC_ prefix — it must never reach the browser.
# MAPBOX_SERVER_TOKEN=

# HUD Fair Market Rents — free token, register at
# https://www.huduser.gov/hudapi/public/register
# Without it the rent-vs-benchmark check reports itself as not run.
HUD_API_TOKEN=

# Anthropic — only needed to read listings from outside Craigslist.
# Server-side only; never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Defaults to claude-haiku-4-5. Opus costs ~5x more per listing.
# ANTHROPIC_MODEL=claude-opus-5

# Autumn AI — no longer used by the checker. Kept because the person-research
# stage is the one piece that is genuinely hard to build from public records.
# AUTUMN_API_KEY=

# Supabase. Without these the map falls back to the seed listings and nothing
# is saved. Use the anon/publishable key — never service_role, which bypasses
# every row-level policy and must not reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Lets a request re-run a check that is already stored, by sending
# `{"force": true}` with an `x-recheck-secret` header matching this value.
# Leave it unset — which is the default — and force is never honoured, so a
# visitor cannot make the county, HUD, Census and TREC APIs re-answer the same
# question from our IP on demand.
# RECHECK_SECRET=
